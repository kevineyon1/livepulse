    "background_effects": { "type": "noise-field", "description": "Gradien fbm-noise mengalir crimson→plum→teal, vignette ke #0c0d0e", "technology": "Three.js ShaderMaterial", "params": { "color_palette": ["#8b3143", "#5c333c", "#304745", "#0c0d0e"], "speed": "0.035 (naik saat scanning)", "density": "fbm 5 oktaf", "opacity": "0.5–0.8", "blend_mode": "normal" } },
