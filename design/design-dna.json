    "3d_elements": { "enabled": false, "type": "scene-bg", "description": "Tidak ada objek 3D; WebGL dipakai untuk latar", "technology": "Three.js", "params": { "renderer": "WebGLRenderer low-power", "lighting": "none", "camera": "Orthographic", "materials": "ShaderMaterial", "geometry": "PlaneGeometry fullscreen + Points", "post_processing": [], "interaction_model": "status aplikasi (energy, mood)" } },
    "shader_effects": { "enabled": true, "type": "noise-distortion", "description": "Domain-warped fbm + pita scan saat OCR", "technology": "GLSL", "params": { "uniforms": ["uTime", "uRes", "uEnergy", "uMood", "uMoodAmt"], "vertex_manipulation": "none", "fragment_output": "gradien diagonal + vignette", "noise_type": "fbm", "distortion": "domain warp" } },
